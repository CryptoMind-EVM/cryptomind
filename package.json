{
  "name": "stock-agent-frontend",
  "version": "1.0.0",
  "description": "Frontend build scripts for CryptoMind",
  "scripts": {
    "build:css": "npx tailwindcss -i ./web/css/tailwind-src.css -o ./web/css/tailwind-built.css --minify",
    "watch:css": "npx tailwindcss -i ./web/css/tailwind-src.css -o ./web/css/tailwind-built.css --watch",
    "dev": "vite",
    "build": "npm run build:css && vite build",
    "preview": "vite preview",
    "i18n:zh-cn": "node scripts/i18n/gen_zh_cn.mjs",
    "i18n:check": "node scripts/i18n/gen_zh_cn.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "opencc-js": "^1.4.2",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.8",
    "vite-plugin-pwa": "^1.3.0"
  },
  "main": "tailwind.config.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CryptoMind-EVM/cryptomind.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/CryptoMind-EVM/cryptomind/issues"
  },
  "homepage": "https://github.com/CryptoMind-EVM/cryptomind#readme",
  "overrides": {
    "picomatch": "^4.0.4",
    "axios": "^1.20.0"
  },
  "dependencies": {
    "@reown/appkit": "^1.8.21",
    "@reown/appkit-adapter-ethers": "^1.8.21",
    "ethers": "^6.13.2"
  }
}
